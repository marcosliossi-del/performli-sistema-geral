{
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron/recurrences",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/resultados",
      "schedule": "0 9 * * 1"
    }
  ],
  "functions": {
    "src/app/api/sync/**": {
      "maxDuration": 300
    },
    "src/app/api/cron/**": {
      "maxDuration": 300
    },
    "src/app/api/nuvemshop/**": {
      "maxDuration": 60
    },
    "src/app/api/admin/knowledge/**": {
      "maxDuration": 120
    }
  }
}
