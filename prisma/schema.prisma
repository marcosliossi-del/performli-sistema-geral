generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH / TEAM ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  ANALYST
  CS      // Customer Success — sees all clients, read-only
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ANALYST)
  avatarUrl    String?
  active       Boolean  @default(true)
  // Papel operacional (rotina Arkza) — separado do RBAC. Rastreabilidade ClickUp.
  operationalRole OperationalRole?
  externalId      String?          @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  managedClients       ClientAssignment[]
  clientsAsGestor      Client[]             @relation("ClientGestor")
  clientsAsCS          Client[]             @relation("ClientCS")
  clientsAsSupervisor  Client[]             @relation("ClientSupervisor")
  clientsAsHead        Client[]             @relation("ClientHead")
  clientsAsCRM         Client[]             @relation("ClientCRM")
  tasks                Task[]
  operations           Operation[]
  aiConversations      AIConversation[]
  alerts               Alert[]              @relation("TriggeredAlerts")
  chatMessages         ClientChatMessage[]
  weeklyChecklists     WeeklyChecklist[]
  checkinsSubmitted    ClientWeeklyCheckin[] @relation("CheckinManager")
  checkinsReviewed     ClientWeeklyCheckin[] @relation("CheckinReviewer")
  interactions         ClientInteraction[]
  knowledgeDocuments   KnowledgeDocument[]
  agencyActivities     AgencyActivity[]
  contracts            Contract[]           @relation("ContractResponsible")
  responsibleWarRooms  CriticalProtocol[]   @relation("WarRoomResponsible")
  auditLogs            AuditLog[]
}

// ─── CLIENTS ─────────────────────────────────────────────────────────────────

enum ClientStatus {
  ACTIVE
  PAUSED
  CHURNED
}

enum BusinessType {
  ECOMMERCE
  LOCAL
  B2B
}

/// Papel operacional na rotina da Arkza (Head/Supervisor/Gestor/CRM/CS/Acompanhamento).
/// Separado do RBAC (Role) — este NÃO governa autorização, só a operação/roteamento.
enum OperationalRole {
  HEAD
  SUPERVISOR
  GESTOR
  CRM
  CS
  ACOMPANHAMENTO
}

/// Saúde operacional do cliente (derivada por agente/serviço).
enum ClientHealthStatus {
  SAUDAVEL
  ATENCAO
  CRITICO
  POSSIVEL_CHURN
  WAR_ROOM
  ARQUIVADO
}

// Resultado semanal do cliente (calculado a partir do ROAS para ecommerce)
enum ClientResultado {
  OTIMO
  BOM
  REGULAR
  RUIM
  PESSIMO
}

// Etapa operacional derivada automaticamente do Resultado
enum ClientEtapa {
  ESCALA          // Resultado Ótimo
  MONITORAMENTO   // Resultado Bom ou Regular
  OTIMIZACAO      // Resultado Ruim ou Péssimo
}

// Ficha de CS — dimensões de relacionamento preenchidas manualmente pela CS
enum ClientNps {
  PROMOTOR
  NEUTRO
  DETRATOR
}

enum ClientRelacionamento {
  OTIMO
  BOM
  REGULAR
  RUIM
  PESSIMO
}

enum ClientCurva {
  A
  B
  C
}

enum PipelineStage {
  LEAD
  PROPOSTA
  NEGOCIACAO
  ATIVO
  CHURNED
}

enum InteractionType {
  LIGACAO
  REUNIAO
  EMAIL
  WHATSAPP
  NOTA
  PROPOSTA_ENVIADA
  CONTRATO_ASSINADO
}

model Client {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  logoUrl        String?
  industry       String?
  website        String?
  email          String?
  phone          String?
  document       String?
  status         ClientStatus  @default(ACTIVE)
  businessType   BusinessType  @default(ECOMMERCE)
  pipelineStage  PipelineStage @default(ATIVO)
  contractValue  Decimal?
  contractStart  DateTime?
  source         String?
  tags           String[]
  notes          String?
  // ── CSX/OPE: Resultado semanal automatizado (ROAS/GA4) ───────────────────
  resultado          ClientResultado?  // Ótimo/Bom/Regular/Ruim/Péssimo (calculado p/ ecommerce)
  etapa              ClientEtapa?       // Escala/Monitoramento/Otimização (derivado do resultado)
  resultadoRoas      Decimal?  @db.Decimal(8, 4) // ROAS da última semana avaliada
  resultadoWeek      String?            // janela avaliada (YYYY-MM-DD do domingo) — idempotência
  resultadoUpdatedAt DateTime?          // última atualização automática do resultado
  // ── Ficha de CS (manual) ─────────────────────────────────────────────────
  nps            ClientNps?
  relacionamento ClientRelacionamento?
  engajamento    ClientRelacionamento?   // mesma escala (Ótimo→Péssimo)
  curva          ClientCurva?
  feedbackNegativo Int      @default(0)  // reclamações registradas na semana
  possivelChurn    Boolean  @default(false)
  salaDeGuerra     Boolean  @default(false)
  healthStatus     ClientHealthStatus?
  fichaCsUpdatedAt DateTime?

  // ── Rastreabilidade + responsáveis por papel (fonte da verdade da operação) ─
  externalId   String?  @unique   // id da lista de tráfego no ClickUp
  gestorId     String?
  csId         String?
  supervisorId String?
  headId       String?
  crmId        String?
  gestor       User? @relation("ClientGestor",     fields: [gestorId],     references: [id], onDelete: SetNull)
  cs           User? @relation("ClientCS",         fields: [csId],         references: [id], onDelete: SetNull)
  supervisor   User? @relation("ClientSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  head         User? @relation("ClientHead",       fields: [headId],       references: [id], onDelete: SetNull)
  crm          User? @relation("ClientCRM",        fields: [crmId],        references: [id], onDelete: SetNull)

  // ── Metas e configuração operacional ───────────────────────────────────────
  plataformas         String[]  @default([])  // Meta, Google, Tiktok
  produtos            String[]  @default([])  // Tráfego Pago, CRM Zoppy, Rastreamento
  roasMinimo          Decimal?  @db.Decimal(8, 2)
  cpaMaximo           Decimal?  @db.Decimal(12, 2)
  investimentoMeta    Decimal?  @db.Decimal(12, 2)
  investimentoGoogle  Decimal?  @db.Decimal(12, 2)
  investimentoTiktok  Decimal?  @db.Decimal(12, 2)
  faturamentoEsperado Decimal?  @db.Decimal(12, 2)
  dashboardLooker     String?
  painelEcommerce     String?
  whatsapp            String?
  // Cache desnormalizado do Contract (Contract continua fonte da verdade)
  billingDueDay   Int?
  feeAmount       Decimal?  @db.Decimal(12, 2)
  contractEndDate DateTime?
  precisaCompletarCadastro Boolean @default(false)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  assignments       ClientAssignment[]
  platformAccounts  PlatformAccount[]
  goals             Goal[]
  metricSnapshots   MetricSnapshot[]
  campaignSnapshots CampaignSnapshot[]
  healthScores      HealthScore[]
  alerts            Alert[]
  operations        Operation[]
  tasks             Task[]
  insights          ClientInsight[]
  chat              ClientChat?
  churnRiskScores   ChurnRiskScore[]
  weeklyReports     WeeklyReport[]
  monthlyReports    MonthlyReport[]
  interactions      ClientInteraction[]
  asaasCustomer       AsaasCustomer?
  statusStreak        ClientStatusStreak?
  criticalProtocols   CriticalProtocol[]
  contracts           Contract[]
  auditLogs           AuditLog[]
  weeklyCheckins      ClientWeeklyCheckin[]
  taskLists           TaskList[]

  @@index([status])
  @@index([pipelineStage])
  @@index([gestorId])
  @@index([csId])
}

model ClientInteraction {
  id          String          @id @default(cuid())
  clientId    String
  userId      String
  type        InteractionType
  description String
  createdAt   DateTime        @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model ClientAssignment {
  id         String   @id @default(cuid())
  clientId   String
  userId     String
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
}

// ─── PLATFORM ACCOUNTS ───────────────────────────────────────────────────────

enum Platform {
  META_ADS
  GOOGLE_ADS
  TIKTOK_ADS
  GA4
  NUVEMSHOP
}

model PlatformAccount {
  id             String    @id @default(cuid())
  clientId       String
  platform       Platform
  externalId     String
  name           String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  active         Boolean   @default(true)
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  metricSnapshots    MetricSnapshot[]
  campaignSnapshots  CampaignSnapshot[]
  syncLogs           SyncLog[]
  nuvemshopStore     NuvemshopStore?

  @@unique([clientId, platform, externalId])
}

// ─── METRICS ─────────────────────────────────────────────────────────────────

enum MetricType {
  ROAS
  CPL
  CPA
  INVESTMENT
  CONVERSIONS
  SALES
  CTR
  CPC
  IMPRESSIONS
  REACH
  FREQUENCY
  CLICKS
  SPEND
  // ── Novas métricas e-commerce ─────────────────────────────────────────────
  FATURAMENTO      // receita total de compras
  TICKET_MEDIO     // receita / conversões
  TAXA_CONVERSAO   // conversões / sessões × 100
  CPS              // custo por sessão (spend / sessões)
  CPM              // custo por mil impressões
  CAC              // custo por aquisição de NOVO cliente (spend / novos usuários GA4)
  // ── Métricas negócios locais ──────────────────────────────────────────────
  MENSAGENS        // mensagens recebidas (WhatsApp, Instagram DM, Google Business)
  VISITAS_PERFIL   // visitas ao perfil (Google Business, Instagram, Facebook)
  LIGACOES         // ligações recebidas (Google Business)
  AGENDAMENTOS     // agendamentos / reservas realizadas
  LEADS            // leads gerados (evento de lead GA4 ou pixel)
  SEGUIDORES       // seguidores (Meta/Instagram)
}

model MetricSnapshot {
  id                String   @id @default(cuid())
  clientId          String
  platformAccountId String
  date              DateTime @db.Date

  spend           Decimal? @db.Decimal(12, 2)
  impressions     Int?
  clicks          Int?
  reach           Int?
  newUsers        Int?     // GA4: novos usuários únicos (base para CAC)
  frequency       Decimal? @db.Decimal(8, 4)
  ctr             Decimal? @db.Decimal(8, 4)
  cpc             Decimal? @db.Decimal(10, 4)
  conversions     Int?
  conversionValue Decimal? @db.Decimal(12, 2)
  roas            Decimal? @db.Decimal(8, 4)
  cpl             Decimal? @db.Decimal(10, 4)
  cpa             Decimal? @db.Decimal(10, 4)
  addToCarts      Int?     // GA4: eventos add_to_cart
  checkoutsStarted Int?    // GA4: eventos begin_checkout
  mensagens       Int?     // Meta: conversas iniciadas por mensagem (messaging_conversation_started)
  landingPageViews Int?    // Meta: visualizações da página de destino (landing_page_view)
  thruplays       Int?     // Meta: reproduções completas de vídeo (video_thruplay_watched)
  videoViews3s    Int?     // Meta: reproduções de vídeo ≥3s (video_view)
  rawData         Json?

  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platformAccount PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)

  @@unique([platformAccountId, date])
  @@index([clientId, date])
  @@index([date])
}

// ─── GOALS ───────────────────────────────────────────────────────────────────

enum GoalPeriod {
  WEEKLY
  MONTHLY
}

model Goal {
  id          String     @id @default(cuid())
  clientId    String
  metric      MetricType
  period      GoalPeriod
  targetValue Decimal    @db.Decimal(12, 4)
  startDate   DateTime   @db.Date
  endDate     DateTime   @db.Date
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  healthScores HealthScore[]

  @@unique([clientId, metric, period, startDate])
  @@index([clientId, startDate])
}

// ─── HEALTH SCORES ───────────────────────────────────────────────────────────

enum HealthStatus {
  OTIMO
  REGULAR
  RUIM
}

model ClientStatusStreak {
  id         String        @id @default(cuid())
  clientId   String        @unique
  status     HealthStatus
  prevStatus HealthStatus? // status anterior ao streak atual (para mostrar seta de tendência)
  since      DateTime      @db.Date
  days       Int           @default(1)
  updatedAt  DateTime      @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model HealthScore {
  id             String       @id @default(cuid())
  clientId       String
  goalId         String
  metric         MetricType
  period         GoalPeriod
  periodStart    DateTime     @db.Date
  periodEnd      DateTime     @db.Date
  targetValue    Decimal      @db.Decimal(12, 4)
  actualValue    Decimal      @db.Decimal(12, 4)
  achievementPct Decimal      @db.Decimal(8, 4)
  status         HealthStatus
  trendPct       Decimal?     @db.Decimal(8, 4)  // % change last 7d vs prior 7d (null = insufficient data)
  calculatedAt   DateTime     @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([clientId, goalId, periodStart])
  @@index([clientId, periodStart])
  @@index([status])
}

// ─── CRITICAL ACCOUNT PROTOCOL ───────────────────────────────────────────────

enum CriticalProtocolStatus {
  ATIVADO       // Protocolo ativado — aguarda diagnóstico do gestor
  EM_EXECUCAO   // Gestor documentou plano, execução em andamento
  MONITORANDO   // CS comunicou cliente, monitorando evolução
  ENCERRADO     // Protocolo encerrado (positivo, neutro ou negativo)
}

enum WarRoomOutcome {
  RESOLVIDO_POSITIVO   // Cliente recuperado — critério de saída atingido
  ENCERRADO_NEUTRO     // Encerrado sem resolução clara
  PERDIDO_CHURN        // Cliente cancelou
}

model CriticalProtocol {
  id          String                 @id @default(cuid())
  clientId    String
  trigger     AlertType
  status      CriticalProtocolStatus @default(ATIVADO)
  activatedAt DateTime               @default(now())
  closedAt    DateTime?
  briefingCS  String?                @db.Text
  notes       String?                @db.Text
  updatedAt   DateTime               @updatedAt

  // ── WAR-14: plano da War Room (aditivo, nullable até o gestor preencher) ──
  diagnosis     String?         @db.Text       // Diagnóstico / hipótese de causa
  exitCriteria  String?         @db.Text       // Critério de saída em linguagem operacional (obrigatório por regra de negócio)
  exitMetric    MetricType?                    // Métrica mensurável do critério (reusa enum existente)
  exitTarget    Decimal?        @db.Decimal(12, 2) // Valor-alvo (ex.: ROAS 1.5)
  exitMetAt     DateTime?                      // Quando o critério foi atingido (WAR-16)
  responsibleId String?                        // Responsável pela War Room
  deadline      DateTime?                      // Prazo da War Room
  escalatedAt   DateTime?                      // Escalação para Marcos (3 semanas) — idempotência
  closedOutcome WarRoomOutcome?                // Resultado do encerramento
  lastReviewedAt DateTime?                     // WAR-16: última revisão semanal registrada

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  responsible User?  @relation("WarRoomResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  @@index([clientId, status])
  @@index([status])
  @@index([responsibleId])
  @@index([escalatedAt])
}

// ─── AUDIT LOG (transversal — CLAUDE.md regra técnica #8) ────────────────────
// Trilha imutável append-only de mutações sensíveis. Sem update/delete.

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?                 // User que executou (null = sistema/cron)
  actorRole  String?                 // Snapshot do papel no momento da ação
  action     String                  // Ex.: 'warroom.set_plan', 'warroom.close'
  entityType String                  // Ex.: 'CriticalProtocol'
  entityId   String
  clientId   String?                 // Cliente afetado, quando aplicável
  metadata   Json?                   // Payload resumido (antes/depois)
  createdAt  DateTime @default(now())

  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([clientId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// ─── ALERTS ──────────────────────────────────────────────────────────────────

enum AlertType {
  STATUS_DROPPED_TO_RUIM
  STATUS_DROPPED_TO_REGULAR
  STATUS_IMPROVED_TO_OTIMO
  SYNC_FAILED
  BUDGET_EXHAUSTED
  BUDGET_WARNING
  KPI_DROP_24H
  KPI_SPIKE_24H
  ROAS_BELOW_TARGET_2W
  FATURAMENTO_BELOW_70PCT_WEEK2
  CONTRACT_EXPIRING_SOON
  // ── WAR-16: acompanhamento pós-War Room ──────────────────────────────────
  WARROOM_NO_REVIEW            // War Room sem revisão semanal
  WARROOM_EXIT_CRITERIA_MET    // Critério de saída atingido — avaliar encerramento
  WARROOM_REGRESSION           // Critério de saída deixou de ser cumprido
  // ── FIN-19: contas a receber e inadimplência ─────────────────────────────
  INVOICE_OVERDUE              // Fatura vencida — régua de cobrança
  CLIENT_WITHOUT_BILLING       // Cliente ativo sem cobrança ativa no Asaas
  // ── CSX-13: anti-churn proativo ──────────────────────────────────────────
  ANTICHURN_ACTION_NEEDED      // Cliente em risco e silencioso — ação proativa necessária
  // ── OPE-06: check-in semanal ─────────────────────────────────────────────
  CHECKIN_MISSING              // Cliente sem check-in preenchido na semana
  CHECKIN_REJECTED_STALE       // Check-in reprovado sem correção no prazo
}

model Alert {
  id          String    @id @default(cuid())
  clientId    String
  type        AlertType
  title       String
  body        String
  read        Boolean   @default(false)
  triggeredBy String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User?  @relation("TriggeredAlerts", fields: [triggeredBy], references: [id])

  @@index([clientId, read])
  @@index([createdAt])
}

// ─── TASKS ───────────────────────────────────────────────────────────────────

// ─── CENTRAL OPERACIONAL (BLOCO 1) — Task como entidade central ──────────────
// Enums substituídos (backfill na migration): PENDING→A_FAZER, IN_PROGRESS→
// EM_ANDAMENTO, DONE→CONCLUIDO, CANCELLED→CANCELADO; LOW→BAIXA, MEDIUM→MEDIA, HIGH→ALTA.

enum TaskStatus {
  A_FAZER
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  AGUARDANDO_GESTOR
  AGUARDANDO_CS
  EM_VALIDACAO
  AJUSTES_SOLICITADOS
  BLOQUEADO
  ATRASADO
  CONCLUIDO
  CANCELADO
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum TaskType {
  SIMPLES
  RECORRENTE
  CHECKLIST_OPERACIONAL
  APROVACAO
  VALIDACAO
  FOLLOWUP
  REUNIAO
  COBRANCA
  AUDITORIA
  RELATORIO
  DEMANDA_CLIENTE
  DEMANDA_INTERNA
  MELHORIA_PROCESSO
  BUG_OPERACIONAL
  WAR_ROOM
  ONBOARDING
  FINANCEIRA
  COMERCIAL
  CS
  GERADA_POR_ALERTA
  GERADA_POR_POP
  GERADA_POR_IA
}

// Direção de uma demanda do Hub de Suporte (quem pediu para quem).
enum SupportDirection {
  CLIENTE_PARA_NOS
  NOS_PARA_CLIENTE
}

enum TaskOrigin {
  MANUAL
  TEMPLATE
  RECORRENCIA
  AUTOMACAO
  ALERTA
  IA
  WHATSAPP
}

enum AreaCode {
  COMERCIAL
  ONBOARDING
  TRAFEGO
  SUCESSO_CLIENTE
  WAR_ROOM
  CRM_AUTOMACAO
  FINANCEIRO
  JURIDICO
  GESTAO_INTERNA
  CONTEUDO
}

enum RecurrenceFrequency {
  DIARIA
  DIA_UTIL
  SEMANAL
  QUINZENAL
  TRIMESTRAL
  MENSAL
  DIA_DO_MES
  DIA_DA_SEMANA
  POR_CLIENTE_ATIVO
  POR_STATUS_CLIENTE
  POR_MUDANCA_ETAPA
  POR_EVENTO
  POR_CONDICAO
}

enum AutomationLogStatus {
  SUCESSO
  FALHA
  DUPLICIDADE_EVITADA
}

enum CustomFieldType {
  TEXT
  NUMBER
  CURRENCY
  PERCENT
  DATE
  BOOLEAN
  SELECT
  MULTISELECT
  URL
  USER_REF
  CLIENT_REF
}

model TaskArea {
  id        String   @id @default(cuid())
  code      AreaCode @unique
  name      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pops      POPProcess[]
  lists     TaskList[]
  templates TaskTemplate[]
  tasks     Task[]
}

model POPProcess {
  id        String   @id @default(cuid())
  code      String   @unique // ex.: OPE-06
  name      String
  objective String?
  areaId    String
  area      TaskArea @relation(fields: [areaId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps     POPStep[]
  frictions POPFriction[]
  templates TaskTemplate[]
  tasks     Task[]
}

model POPStep {
  id          String     @id @default(cuid())
  popId       String
  pop         POPProcess @relation(fields: [popId], references: [id], onDelete: Cascade)
  order       Int        @default(0)
  description String
  required    Boolean    @default(true)
}

model POPFriction {
  id          String     @id @default(cuid())
  popId       String
  pop         POPProcess @relation(fields: [popId], references: [id], onDelete: Cascade)
  description String
}

model TaskList {
  id         String    @id @default(cuid())
  name       String
  areaId     String?
  area       TaskArea? @relation(fields: [areaId], references: [id])
  externalId String?   @unique   // id da lista no ClickUp
  clientId   String?              // quando a lista representa um cliente (recorrentes)
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tasks     Task[]

  @@index([clientId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(A_FAZER)
  priority    TaskPriority @default(MEDIA)
  dueDate     DateTime?
  clientId    String?
  assignedTo  String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // ── Central Operacional (aditivo) ──────────────────────────────────────────
  type          TaskType   @default(SIMPLES)
  origin        TaskOrigin @default(MANUAL)

  areaId        String?
  area          TaskArea?    @relation(fields: [areaId], references: [id])
  popId         String?
  pop           POPProcess?  @relation(fields: [popId], references: [id])
  listId        String?
  list          TaskList?    @relation(fields: [listId], references: [id])

  leadId        String?     // AgencyLead vinculado (id, sem FK)
  contractId    String?     // Contract vinculado (id, sem FK)

  requesterId   String?
  requestedAt   DateTime?   // data do pedido (obrigatória via validação)
  startDate     DateTime?
  completedAt   DateTime?
  completedById String?

  slaHours      Int?
  slaBreached   Boolean     @default(false)

  templateId    String?
  template      TaskTemplate?       @relation(fields: [templateId], references: [id])
  recurrenceId  String?
  recurrence    TaskRecurrenceRule? @relation(fields: [recurrenceId], references: [id])
  idempotencyKey String?    @unique // (template+cliente+janela)

  evidence      String?
  blockReason   String?
  delayReason   String?

  // ── FASE 5 — TaskCompletionGuard (aditivo, flag-gated) ─────────────────────
  reviewerId          String?  // quem valida (id, sem FK — igual requesterId)
  requiresEvidence    Boolean  @default(false)
  requiresReview      Boolean  @default(false)
  qualityScore        Int?
  riskScore           Int?
  completionNotes     String?
  sourcePopCode       String?
  isGeneratedByAgent  Boolean  @default(false)
  generatedByAgentName String?

  tags          String[]    @default([])

  // ── Hub de Suporte (aditivo) ───────────────────────────────────────────────
  isSupport        Boolean           @default(false)
  supportDirection SupportDirection?

  parentId      String?
  parent        Task?       @relation("Subtasks", fields: [parentId], references: [id])
  subtasks      Task[]      @relation("Subtasks")

  checklist    TaskChecklistItem[]
  comments     TaskComment[]
  attachments  TaskAttachment[]
  activities   TaskActivity[]
  watchers     TaskWatcher[]
  approvals    TaskApproval[]
  customValues TaskCustomFieldValue[]
  auxAssignees TaskAuxAssignee[]

  dependsOn TaskDependency[] @relation("DependentTask")
  blocks    TaskDependency[] @relation("BlockingTask")

  client Client? @relation(fields: [clientId], references: [id])
  user   User    @relation(fields: [assignedTo], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([assignedTo])
  @@index([status])
  @@index([dueDate])
  @@index([areaId])
  @@index([popId])
}

