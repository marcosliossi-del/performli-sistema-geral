// ─── OPE-06: CHECK-IN SEMANAL POR CLIENTE ─────────────────────────────────────
// Diferente de WeeklyChecklist (lista de tarefas POR GESTOR): este é o check-in
// POR CLIENTE com workflow de validação da CS (preenchido → aprovado/reprovado).

enum CheckinStatus {
  PENDENTE     // ainda não preenchido pelo gestor
  PREENCHIDO   // gestor preencheu, aguardando revisão da CS
  APROVADO     // CS aprovou
  REPROVADO    // CS reprovou — gestor precisa corrigir
}

model ClientWeeklyCheckin {
  id           String        @id @default(cuid())
  clientId     String
  weekStart    DateTime      @db.Date
  managerId    String
  status       CheckinStatus @default(PENDENTE)

  // Conteúdo do check-in (preenchido pelo gestor)
  problema        String? @db.Text   // Q1: principal problema da semana + hipótese
  resultadoSemana String? @db.Text   // Q3: o que aconteceu nas métricas (resultado das ações)
  oQueFoiFeito    String? @db.Text   // Q2: ações executadas
  proximosPassos  String? @db.Text   // Q4: plano para a próxima semana
  pedidosCliente  String? @db.Text   // Q5: o que precisa do cliente
  novosSeguidores Int?               // Q6: novos seguidores no período

  submittedAt  DateTime?
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?       @db.Text  // motivo de reprovação / observação da CS

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  manager    User   @relation("CheckinManager", fields: [managerId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("CheckinReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([clientId, weekStart])
  @@index([status, weekStart])
  @@index([managerId, weekStart])
  @@index([clientId, weekStart])
}

