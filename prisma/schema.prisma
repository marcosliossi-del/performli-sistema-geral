  key       String   @id   // e.g. "EVOLUTION_URL", "EVOLUTION_KEY", "EVOLUTION_INSTANCE"
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ─── EXPENSES (DRE manual) ────────────────────────────────────────────────────

enum ExpenseCategory {
  SALARIOS
  MARKETING
  FERRAMENTAS
  IMPOSTOS
  CONTABILIDADE
  ESCRITORIO
  OUTROS
}

model Expense {
  id          String          @id @default(cuid())
  description String
  category    ExpenseCategory
  value       Decimal         @db.Decimal(12, 2)
  date        DateTime        @db.Date
  recurring   Boolean         @default(false)
  notes       String?         @db.Text
  source      String          @default("MANUAL")  // MANUAL | ASAAS
  externalId  String?         @unique              // Asaas financial transaction ID
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([date])
  @@index([source])
}

// ─── CONTRACTS (Jurídico) ─────────────────────────────────────────────────────

enum ContractStatus {
  RASCUNHO
  VIGENTE
  RENOVACAO
  CANCELADO
}

enum ContractType {
  FEE_MENSAL
  PROJETO
  AVULSO
}

model Contract {
  id                 String         @id @default(cuid())
  clientId           String
  responsibleId      String?
  status             ContractStatus @default(RASCUNHO)
  type               ContractType   @default(FEE_MENSAL)
  feeValue           Decimal        @db.Decimal(12, 2)
  setupFee           Decimal?       @db.Decimal(12, 2)
  startDate          DateTime       @db.Date
  endDate            DateTime       @db.Date
  noticeDays         Int            @default(30)
  autoRenew          Boolean        @default(false)
  documentUrl        String?        // link para PDF (Google Drive, etc.)
  notes              String?        @db.Text
  signedAt           DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  previousContractId String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  responsible      User?     @relation("ContractResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  previousContract Contract? @relation("ContractRenewal", fields: [previousContractId], references: [id])
  renewals         Contract[] @relation("ContractRenewal")

  @@index([clientId, status])
  @@index([endDate])
  @@index([status])
}

/// Rate limiting por janela fixa (fixed-window). Chave = escopo+identificador.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}
